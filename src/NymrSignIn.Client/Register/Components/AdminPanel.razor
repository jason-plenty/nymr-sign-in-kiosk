@inject IRegisterApiService RegisterApi
@inject IJSRuntime JS

<div class="admin-panel">
    <p>End of day — download report or trigger email</p>
    <div class="admin-buttons">
        <button class="btn-icon btn-blue"
                @onclick="DownloadCsvAsync"
                disabled="@_isDownloading"
                aria-label="Download CSV report">
            @if (_isDownloading)
            {
                <LoadingSpinner IsVisible="true" />
            }
            DOWNLOAD CSV
        </button>
        <button class="btn-icon btn-green"
                @onclick="SendEmailAsync"
                disabled="@_isSending"
                aria-label="Send email report now">
            @if (_isSending)
            {
                <LoadingSpinner IsVisible="true" />
            }
            EMAIL REPORT NOW
        </button>
    </div>

    <ToastNotification Message="@_toastMessage" IsSuccess="@_toastSuccess" />
</div>

@code {
    private bool _isDownloading;
    private bool _isSending;
    private string? _toastMessage;
    private bool _toastSuccess;

    private async Task DownloadCsvAsync()
    {
        _isDownloading = true;
        try
        {
            var csvBytes = await RegisterApi.ExportCsvAsync();
            var base64 = Convert.ToBase64String(csvBytes);
            var fileName = $"site-register-{DateTime.Now:yyyy-MM-dd}.csv";

            await JS.InvokeVoidAsync("eval", $@"
                var a = document.createElement('a');
                a.href = 'data:text/csv;base64,{base64}';
                a.download = '{fileName}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            ");

            ShowToast("CSV downloaded.", true);
        }
        catch
        {
            ShowToast("Export failed.", false);
        }
        finally
        {
            _isDownloading = false;
        }
    }

    private async Task SendEmailAsync()
    {
        _isSending = true;
        try
        {
            await RegisterApi.SendDailyEmailAsync();
            ShowToast("Daily email sent.", true);
        }
        catch
        {
            ShowToast("Email send failed.", false);
        }
        finally
        {
            _isSending = false;
        }
    }

    private void ShowToast(string message, bool isSuccess)
    {
        _toastMessage = message;
        _toastSuccess = isSuccess;
        _ = HideToastAsync();
    }

    private async Task HideToastAsync()
    {
        await Task.Delay(4000);
        _toastMessage = null;
        await InvokeAsync(StateHasChanged);
    }
}
