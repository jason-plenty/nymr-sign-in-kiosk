<div class="card-muted">
    <h2 class="card-header-muted">Signed Out Today (@Entries.Count)</h2>

    @if (Entries.Count == 0)
    {
        <p class="empty-state">No one has signed out yet today.</p>
    }
    else
    {
        @foreach (var person in Entries)
        {
            <div class="signedout-row">
                <span class="signedout-name">@person.Name</span>
                <span class="signedout-detail">@person.Organisation — In: @person.TimeIn &rarr; Out: @person.TimeOut</span>
            </div>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<SignedOutEntry> Entries { get; set; } = [];
}
