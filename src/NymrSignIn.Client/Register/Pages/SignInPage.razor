@page "/"
@inject IRegisterApiService RegisterApi
@inject SignInFlowState FlowState
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>NYMR Site Sign-In</PageTitle>

<div class="page-container">
    <!-- HEADER -->
    <div class="header-signin">
        <div>
            <h1 class="header-title">Bridge 42 — Site Sign-In</h1>
            <p class="header-date">@_todayDisplay</p>
        </div>
        <OnSiteCounter Count="@_signedInList.Count" />
    </div>

    <ToastNotification Message="@_toastMessage" />

    <!-- BODY -->
    <div class="page-body">
        <SafetyBriefing />

        <!-- SIGN-IN FORM -->
        <div class="card">
            <h2 class="card-header">Sign In Below</h2>

            <div class="form-group">
                <label for="name-input">YOUR NAME</label>
                <input id="name-input"
                       type="text"
                       @bind="_formModel.Name"
                       @bind:event="oninput"
                       placeholder="e.g. John Smith"
                       autocomplete="off"
                       aria-required="true" />
                @if (_nameError is not null)
                {
                    <div class="validation-message" role="alert">@_nameError</div>
                }
            </div>

            <div class="form-group">
                <label for="org-input">COMPANY / ORGANISATION</label>
                <input id="org-input"
                       type="text"
                       @bind="_formModel.Organisation"
                       @bind:event="oninput"
                       placeholder="e.g. NYMR, CML, ABC Contractors"
                       autocomplete="off"
                       aria-required="true" />
                @if (_orgError is not null)
                {
                    <div class="validation-message" role="alert">@_orgError</div>
                }
            </div>

            <div class="form-group">
                <label>YOUR SIGNATURE</label>
                <SignaturePad @ref="_signaturePad" />
                <button class="clear-signature" type="button" @onclick="ClearSignatureAsync">
                    Clear Signature
                </button>
                @if (_sigError is not null)
                {
                    <div class="validation-message" role="alert">@_sigError</div>
                }
            </div>

        </div>
    </div>

    <div class="footer-action-bar">
        <button class="btn-footer btn-footer-red"
                type="button"
                @onclick="GoToSignOut"
                disabled="@_isSubmitting"
                aria-label="Go to sign out page">
            &#x1F6AA; GO TO SIGN OUT
        </button>
        <button class="btn-footer btn-footer-green"
                type="button"
                @onclick="HandleSignInAsync"
                disabled="@_isSubmitting"
                aria-label="Sign in now">
            @if (_isSubmitting)
            {
                <LoadingSpinner IsVisible="true" />
                <span>SIGNING IN...</span>
            }
            else
            {
                <span>&#x2713; SIGN IN</span>
            }
        </button>
    </div>
</div>

@code {
    private readonly SignInFormModel _formModel = new();
    private SignaturePad? _signaturePad;
    private List<SignedInEntry> _signedInList = [];
    private bool _isSubmitting;
    private string? _toastMessage;
    private string? _nameError;
    private string? _orgError;
    private string? _sigError;
    private PeriodicTimer? _pollTimer;
    private CancellationTokenSource? _pollCts;
    private readonly string _todayDisplay = DateTime.Now.ToString("dd/MM/yyyy");

    protected override async Task OnInitializedAsync()
    {
        FlowState.Reset();
        await RefreshAsync();
        StartPolling();
    }

    private void StartPolling()
    {
        _pollCts = new CancellationTokenSource();
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = PollLoopAsync(_pollCts.Token);
    }

    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _pollTimer!.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on dispose
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            var data = await RegisterApi.GetTodaysRegisterAsync();
            _signedInList = data.SignedIn.ToList();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Refresh failed: {ex.Message}");
        }
    }

    private async Task HandleSignInAsync()
    {
        ClearErrors();

        var hasError = false;
        if (string.IsNullOrWhiteSpace(_formModel.Name))
        {
            _nameError = "Please enter your name.";
            hasError = true;
        }
        if (string.IsNullOrWhiteSpace(_formModel.Organisation))
        {
            _orgError = "Please enter your organisation.";
            hasError = true;
        }
        if (_signaturePad is not null && await _signaturePad.IsEmptyAsync())
        {
            _sigError = "Please provide your signature.";
            hasError = true;
        }
        if (hasError) return;

        _isSubmitting = true;
        try
        {
            if (_signaturePad is not null)
            {
                _formModel.SignatureBase64 = await _signaturePad.ToDataUrlAsync();
            }

            var result = await RegisterApi.SignInAsync(_formModel);
            FlowState.StartFlow(result);
            Navigation.NavigateTo("/medical");
        }
        catch
        {
            ShowToast("Sign-in failed. Please try again.");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task ClearSignatureAsync()
    {
        if (_signaturePad is not null)
            await _signaturePad.ClearAsync();
    }

    private void ClearErrors()
    {
        _nameError = null;
        _orgError = null;
        _sigError = null;
        _toastMessage = null;
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        _ = HideToastAfterDelayAsync();
    }

    private async Task HideToastAfterDelayAsync()
    {
        await Task.Delay(4000);
        _toastMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    private void GoToSignOut()
    {
        Navigation.NavigateTo("/signout");
    }

    public async ValueTask DisposeAsync()
    {
        _pollCts?.Cancel();
        _pollTimer?.Dispose();
        _pollCts?.Dispose();

        if (_signaturePad is not null)
            await _signaturePad.DisposeAsync();
    }
}
