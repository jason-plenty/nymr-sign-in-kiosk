@page "/not-permitted"
@inject IRegisterApiService RegisterApi
@inject SignInFlowState FlowState
@inject NavigationManager Navigation

<PageTitle>Entry Not Permitted</PageTitle>

<div class="page-container">
    <div class="header-not-permitted">
        <h1 class="header-title">&#x26D4; Entry Not Permitted</h1>
        @if (_person is not null)
        {
            <p class="header-subtitle">@_person.Name — @_person.Organisation</p>
        }
    </div>

    <ToastNotification Message="@_toastMessage" />

    <div class="page-body">
        <div class="card card-red" style="text-align:center;">
            <div class="denied-icon">&#x26D4;</div>
            <h2 style="color: var(--red); font-size: 22px; margin: 0 0 12px;">
                YOU ARE NOT AUTHORISED TO ENTER SITE
            </h2>
            <p style="color: var(--dark); line-height: 1.6; margin: 0;">
                Because you could not confirm the medical self-declaration, you must speak with the
                <strong>Site Controller</strong> before entry can be considered.
            </p>
        </div>

        <div class="card card-blue">
            <h2 class="card-header card-header-blue">
                Contact @ControllerName — Site Controller
            </h2>
            <p class="medical-intro">
                Please contact the Site Controller using one of the methods below. They will discuss your situation and
                may issue you a <strong>One Time Use Site Code</strong> if they authorise your entry.
            </p>

            @if (!string.IsNullOrWhiteSpace(ControllerPhone))
            {
                <div class="contact-link contact-link-call" role="note" aria-label="Site Controller phone number">
                    <div>&#x1F4DE; CALL @ControllerName.ToUpper(): @ControllerPhone</div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(ControllerEmail))
            {
                <button class="contact-link contact-link-email"
                        type="button"
                        @onclick="HandleSendEmailAsync"
                        disabled="@(_isSendingEmail || _emailSent)"
                        aria-label="Email the Site Controller">
                    <div>
                        @if (_isSendingEmail)
                        {
                            <span>SENDING EMAIL&hellip;</span>
                        }
                        else if (_emailSent)
                        {
                            <span>&#x2713; EMAIL SENT TO @ControllerEmail.ToUpper()</span>
                        }
                        else
                        {
                            <span>&#x2709; EMAIL @ControllerName.ToUpper()</span>
                        }
                    </div>
                </button>
            }

            <div class="info-panel">
                &#x2139; Tap <strong>EMAIL</strong> to notify the Site Controller of your situation. They will call you on the number you have given, and issue a one-time code if they authorise your entry.
            </div>
        </div>

        <div class="card">
            <label>PLEASE ADD ANY ADDITIONAL INFORMATION</label>
            <p style="font-size:13px; color: var(--mid); margin: 0 0 8px;">
                Describe your condition or circumstances so the Site Controller can make an informed decision.
            </p>
            <textarea rows="4"
                      placeholder="e.g. I take daily blood pressure medication but it does not impair my work"
                      @bind="_additionalInfo"
                      @bind:event="oninput"></textarea>
        </div>

        <div class="card card-green">
            <h2 class="card-header card-header-green">&#x1F510; Enter One Time Use Site Code</h2>
            <p class="medical-intro">
                If the Site Controller has given you authorisation, enter the
                <strong>One Time Use Site Code</strong> below:
            </p>
            <input type="text"
                   class="site-code-input"
                   placeholder="ENTER CODE HERE"
                   @bind="_siteCode"
                   @bind:event="oninput"
                   autocomplete="off" />

            @if (_codeError is not null)
            {
                <div class="validation-message" role="alert" style="margin-top:8px;">@_codeError</div>
            }
        </div>
    </div>

    <div class="footer-action-bar">
        <button class="btn-footer btn-footer-red"
                type="button"
                @onclick="CancelFlow"
                disabled="@_isSubmitting"
                aria-label="Cancel and return to sign-in">
            &larr; CANCEL
        </button>
        <button class="btn-footer btn-footer-green"
                type="button"
                @onclick="HandleSubmitCodeAsync"
                disabled="@_isSubmitting"
                aria-label="Submit site code">
            @if (_isSubmitting)
            {
                <LoadingSpinner IsVisible="true" />
                <span>VERIFYING...</span>
            }
            else
            {
                <span>&#x1F513; SUBMIT CODE</span>
            }
        </button>
    </div>
</div>

@code {
    private SignInResponseModel? _person;
    private DeclareNotFitResponseModel? _context;
    private string _additionalInfo = string.Empty;
    private string _siteCode = string.Empty;
    private bool _isSubmitting;
    private bool _isSendingEmail;
    private bool _emailSent;
    private string? _toastMessage;
    private string? _codeError;

    protected override void OnInitialized()
    {
        _person = FlowState.CurrentPerson;
        _context = FlowState.NotFitContext;
        if (_person is null || _context is null)
        {
            Navigation.NavigateTo("/");
        }
    }

    private string ControllerName => string.IsNullOrWhiteSpace(_context?.SiteControllerName)
        ? "the Site Controller"
        : _context!.SiteControllerName;

    private string ControllerEmail => _context?.SiteControllerEmail ?? string.Empty;
    private string ControllerPhone => _context?.SiteControllerPhone ?? string.Empty;

    private async Task HandleSendEmailAsync()
    {
        if (_person is null || _emailSent) return;
        _isSendingEmail = true;
        try
        {
            await RegisterApi.SendNotFitAlertAsync(_person.Id);
            _emailSent = true;
            ShowToast($"Email sent to {ControllerName}.");
        }
        catch
        {
            ShowToast("Failed to send email. Please try again.");
        }
        finally
        {
            _isSendingEmail = false;
        }
    }

    private async Task HandleSubmitCodeAsync()
    {
        if (_person is null) return;
        _codeError = null;

        if (string.IsNullOrWhiteSpace(_siteCode))
        {
            _codeError = "Please enter the site code provided by the Site Controller.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var result = await RegisterApi.SubmitSiteCodeAsync(
                _person.Id,
                _siteCode.Trim(),
                string.IsNullOrWhiteSpace(_additionalInfo) ? null : _additionalInfo.Trim());

            if (!result.IsValid || result.Confirmation is null)
            {
                _codeError = result.ErrorMessage ?? "That site code is not recognised.";
                return;
            }

            FlowState.SetConfirmation(result.Confirmation);
            Navigation.NavigateTo("/fit-confirmed");
        }
        catch
        {
            ShowToast("Something went wrong. Please try again.");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void CancelFlow()
    {
        FlowState.Reset();
        Navigation.NavigateTo("/");
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        _ = HideToastAsync();
    }

    private async Task HideToastAsync()
    {
        await Task.Delay(4000);
        _toastMessage = null;
        await InvokeAsync(StateHasChanged);
    }
}
