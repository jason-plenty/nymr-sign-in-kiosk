@if (IsVisible)
{
    <div class="modal-overlay" role="dialog" aria-modal="true" aria-label="Confirmation">
        <div class="modal-content">
            <h3>@Title</h3>
            <p>@Message</p>
            <div class="modal-buttons">
                <button class="btn-danger" @onclick="OnConfirm" aria-label="Confirm">Yes</button>
                <button class="btn-nav-back" @onclick="OnCancel" aria-label="Cancel">No</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "Confirm";
    [Parameter] public string Message { get; set; } = "Are you sure?";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
