<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(KioskLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(KioskLayout)">
            <div class="page-container">
                <div class="page-body">
                    <div class="empty-state">
                        <p>Page not found.</p>
                    </div>
                </div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
